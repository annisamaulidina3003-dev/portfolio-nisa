load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config")
load("//anybuild/tools:php.bzl", "php_serve")

config = laravel_config(
    schema = 1,
    commands = {
        "after_deploy": "php artisan migrate --force",
    },
    node_package_manager = "npm",
    node_version = "24",
    npm_version = "11",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    php_version = "8.3.29",
    php_public_dir = "public",
    phpix = True,
)

build = laravel_build(config)

php_serve(
    config,
    build,
    name = "portfolio-nisa",
    prepare = [],
    build_post = [
        write(
            "{}/.env".format(build.app.path),
            "APP_NAME=PortfolioNisa\nAPP_ENV=production\nAPP_DEBUG=false\nAPP_URL=https://portfolio-nisa.wasmer.app\nLOG_CHANNEL=stderr\nDB_CONNECTION=sqlite\nSESSION_DRIVER=cookie\nCACHE_STORE=array\n",
        ),
        run("printf 'APP_KEY=%s\\n' \"$APP_KEY\" >> /app/.env"),
        run("touch /app/database/database.sqlite && php artisan migrate --force --no-interaction"),
    ],
)
